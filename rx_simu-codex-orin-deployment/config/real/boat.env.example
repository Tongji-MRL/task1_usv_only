#!/usr/bin/env bash
# Copy to <repo>/.env.boat (ignored by Git), then fill measured values.
# Empty values are deliberate: do not substitute the simulation settings.
USV_WORKSPACE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export USV_WORKSPACE
export ROS_DOMAIN_ID=62
export ROS_LOCALHOST_ONLY=1

export USV_FCU_URL=''
export USV_FCU_SYSID=''
# Leave empty for apt packages; set explicit paths for existing/new overlays.
export USV_MAVROS_SETUP=''
export USV_LIVOX_SETUP=''
# Set only when the Livox SDK was installed to an isolated prefix.
export USV_LIVOX_SDK_PREFIX=''
export USV_LIVOX_CONFIG="$USV_WORKSPACE/runs/hardware_config/MID360_config.json"
export USV_LIDAR_NIC=''
export USV_LIDAR_HOST_CIDR=''
export USV_LIDAR_IP=''
export USV_LIDAR_FRAME=''
export USV_LIDAR_X=''
export USV_LIDAR_Y=''
export USV_LIDAR_Z=''
export USV_LIDAR_ROLL=''
export USV_LIDAR_PITCH=''
export USV_LIDAR_YAW=''
# D435 color camera body (x forward, y left, z up) in base_link; metres / radians.
# USV_CAMERA_FRAME is the driver's camera body frame (usually camera_link).
export USV_CAMERA_FRAME=''
export USV_CAMERA_X=''
export USV_CAMERA_Y=''
export USV_CAMERA_Z=''
export USV_CAMERA_ROLL=''
export USV_CAMERA_PITCH=''
export USV_CAMERA_YAW=''
# Polygon in base_link, including both propellers; JSON list of [x,y] metres.
export USV_FOOTPRINT=''
# Accepted obstacle height in base_stabilized (not height above the water).
export USV_MARK_MIN_Z=''
export USV_MARK_MAX_Z=''
# map origin in WGS84; map +X east, +Y north, no additional map rotation.
export USV_MAP_LAT=''
export USV_MAP_LON=''
export USV_MAP_YAML="$USV_WORKSPACE/runs/hardware_config/water.yaml"

# Initial low-speed trial caps, not measured vessel performance.
export USV_MAX_SPEED=0.2
export USV_MAX_YAW_RATE=0.2
