<?xml version="1.0"?>
<package format="3">
  <name>usv_sim</name><version>0.1.0</version>
  <description>VRX sensor adapters and evaluation for pinned ArduRover SITL.</description>
  <maintainer email="admin@example.com">USV navigation</maintainer>
  <license>MIT</license>
  <buildtool_depend>python3-setuptools</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>python3-pymavlink-pip</exec_depend>
  <exec_depend>geographic_msgs</exec_depend><exec_depend>mavros_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
